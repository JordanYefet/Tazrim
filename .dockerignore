# Only source goes into the image. Personal financial data must never get in.
.git
.gitignore
node_modules
.next
out
coverage
*.tsbuildinfo
.DS_Store

# Databases and bank / card exports, wherever they are
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.xls
**/*.xlsx
**/*.csv

# Secrets
**/.env
**/.env.*

# Local tooling and docs (screenshots are not needed to run the app)
.claude
.worktrees
.superpowers
.vscode
.idea
docs
README.md
Dockerfile
docker-compose.yml
.dockerignore
