generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./tazrim.db"
}

/// A bank account or a card. Transactions and uploads always belong to one.
/// The accounts created by the 20261013000000_add_account migration have fixed
/// ids (acct_leumi, acct_max), so the back-fill is reproducible.
model Account {
  id                     String                  @id @default(uuid())
  kind                   AccountKind
  /// Lowercase provider key, e.g. "leumi", "max". Merchant rules
  /// (TransactionAlias) are keyed by it and apply to every account of the provider.
  provider               String
  displayName            String
  cardLastFour           String?
  /// Card network for the card element (ENG-56): visa, mastercard, amex, diners or isracard.
  /// Null when unknown or other; always null for bank accounts.
  cardNetwork            String?
  /// Account colour (ENG-66): a palette key from lib/accounts/colors.ts, a #rrggbb
  /// hex, or "glass". Null means the brand default (issuer/bank face, else positional).
  color                  String?
  /// ENG-69: a Leumi or Max account imports through its linked ImportProfile
  /// instead of the built-in parser. Ignored for providers without one.
  customImport           Boolean                 @default(false)
  archived               Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  bankTransactions       BankTransaction[]
  creditCardTransactions CreditCardTransaction[]
  uploads                UploadHistory[]
  importProfiles         ImportProfile[]

  @@index([kind, provider])
}

model BankTransaction {
  id                  String   @id @default(uuid())
  accountId           String
  account             Account  @relation(fields: [accountId], references: [id])
  date                DateTime
  originalDescription String
  description         String
  debit               Float    @default(0)
  credit              Float    @default(0)
  balance             Float
  note                String   @default("")
  /// A Category name (expense for debits, income for credits); null = uncategorized.
  /// Card-payment rows never get one (lib/insights/bank-categories.ts).
  category            String?
  /// Set on this row by hand, so a BankCategoryRule never overwrites it
  categoryManual      Boolean  @default(false)
  ignored             Boolean  @default(false)
  sourceFile          String

  // date leads (as before accounts existed) so date-ordered reads keep the same plan and row order
  @@unique([date, originalDescription, debit, credit, accountId])
}

model CreditCardTransaction {
  id                   String   @id @default(uuid())
  accountId            String
  account              Account  @relation(fields: [accountId], references: [id])
  transactionDate      DateTime
  billingDate          DateTime
  originalMerchantName String
  merchantName         String
  category             String
  categoryOverride     String?
  chargedAmount        Float
  originalAmount       Float
  originalCurrency     String
  cardLastFour         String
  transactionType      String
  notes                String   @default("")
  ignored              Boolean  @default(false)
  contentHash          String   @default("")
  sourceFile           String   @default("")

  // Same leading columns as before accounts existed, so list reads keep the same plan and row order
  @@index([contentHash, sourceFile, accountId])
  // Card months follow the billing date (ENG-46)
  @@index([accountId, billingDate])
}

/// A merchant / description rule. Keyed by provider (not by account), so it
/// applies to every account of that provider.
model TransactionAlias {
  id               String  @id @default(uuid())
  provider         String
  originalName     String
  displayName      String
  categoryOverride String?

  @@unique([provider, originalName])
}

model UploadHistory {
  id          String   @id @default(uuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  fileName    String
  uploadedAt  DateTime @default(now())
  recordCount Int

  @@index([accountId, fileName])
}

/// Expense categories are shared by cards and bank debits; income ones are for bank credits.
model Category {
  id        String       @id @default(uuid())
  name      String       @unique
  kind      CategoryKind @default(EXPENSE)
  createdAt DateTime     @default(now())
}

enum CategoryKind {
  EXPENSE
  INCOME
}

/// "Every <description> row going <direction> is <category>", for the bank
/// accounts of one provider. Applied on import and when the rule is saved, to
/// rows whose category was not set by hand.
model BankCategoryRule {
  id                  String @id @default(uuid())
  provider            String
  originalDescription String
  /// OUT = debits, IN = credits: the same description can be both
  direction           String
  category            String

  @@unique([provider, originalDescription, direction])
}

/// A user decision about a detected recurring series (lib/insights/recurring.ts).
/// Series are re-detected on every read; this row is matched to them by `key`,
/// or by `baseKey` when the merchant has a single series (see applyOverrides).
/// No FK to Account: the key already encodes the account and the row is harmless
/// if the account goes away.
model RecurringSeriesOverride {
  id          String           @id @default(uuid())
  key         String           @unique
  baseKey     String
  accountId   String?
  status      RecurringStatus?
  displayName String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([baseKey])
}

/// A recurring series the user defined by hand (ENG-71): a rule on one account,
/// matched against all of its transactions on every read (lib/insights/manual-recurring.ts).
/// No FK to Account, like RecurringSeriesOverride; deleteAccount removes the rows.
model ManualRecurringSeries {
  id        String                  @id @default(uuid())
  accountId String
  /// "bank" or "card", from the account kind when it was created
  source    String
  name      String
  /// monthly, bimonthly or yearly
  cadence   String
  /// normalizePattern() of the description; "" = attached transactions only
  pattern   String                  @default("")
  /// optional day-of-month window, inclusive; may wrap (28..3). Both set or both null.
  dayFrom   Int?
  dayTo     Int?
  /// optional amount range in ₪, inclusive; either end may be null (open) (ENG-71 follow-up)
  amountMin Float?
  amountMax Float?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  members   ManualRecurringMember[]

  @@index([accountId])
}

/// A transaction attached to, or detached from, a manual series by hand. Spans both
/// transaction tables (the series' source says which), so there is no FK to it; an
/// orphan is harmless and never matches.
model ManualRecurringMember {
  id            String                @id @default(uuid())
  seriesId      String
  series        ManualRecurringSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  transactionId String
  /// ATTACHED: always in the series. DETACHED: never, even when the rule matches.
  mode          ManualMemberMode

  @@unique([seriesId, transactionId])
  @@index([transactionId])
}

enum ManualMemberMode {
  ATTACHED
  DETACHED
}

enum RecurringStatus {
  CONFIRMED
  DISMISSED
}

/// A transaction the user marked as "not unusual" (ENG-38). It spans both
/// transaction tables, so there is no foreign key; an orphan (its transaction
/// was deleted) is harmless and simply never matches.
model UnusualDismissal {
  id            String   @id @default(uuid())
  /// "bank" (BankTransaction) or "card" (CreditCardTransaction)
  source        String
  transactionId String
  /// The flag reason shown when it was dismissed, for reference only
  reason        String?
  createdAt     DateTime @default(now())

  @@unique([source, transactionId])
}

/// TRADING and PENSION are reserved for later; nothing creates them yet.
enum AccountKind {
  BANK
  CREDIT_CARD
  TRADING
  PENSION
}

/// A saved column mapping for a provider without a built-in parser (ENG-24).
/// Matched to an upload by account kind + provider (or its linked account) and
/// the file's header signature. `mapping` is ImportMapping JSON
/// (lib/import/mapping.ts) and is validated again every time it is used.
model ImportProfile {
  id              String      @id @default(uuid())
  name            String
  accountKind     AccountKind
  provider        String
  mapping         String
  /// headerSignature() of the file the mapping was made on
  headerSignature String
  /// HeaderSnapshot JSON (lib/import/snapshot.ts): the header row and a few sample
  /// rows of the file, so the mapping can be edited without one (ENG-69).
  /// Null for profiles saved before ENG-69. Kept only in this local database.
  headers         String?
  /// The account this profile is the default for; cleared if the account goes away
  accountId       String?
  account         Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([accountKind, provider])
  @@index([accountId])
}
